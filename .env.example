# Copy this file to .env alongside docker-compose.yml.
# Never commit .env: it contains credentials and the encryption key.
EGYM_EMAIL=your-egym-email@example.com
EGYM_PASSWORD=replace-with-egym-password
GARMIN_EMAIL=your-garmin-email@example.com
GARMIN_PASSWORD=replace-with-garmin-password

# Generate once with: openssl rand -base64 32
# Paste the Base64 output below; retain the SAME key for future upgrades.
# If lost, the encrypted Garmin token cache cannot be read.
GARMIN_TOKEN_KEY=replace-with-base64-32-byte-key

# Garmin writes are disabled in docker-compose.example.yml.
# Keep them disabled until read-only import and validation succeed on the NAS.
